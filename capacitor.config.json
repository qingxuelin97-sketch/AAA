{
  "appId": "ai.huanyu.app",
  "appName": "幻域",
  "webDir": "client/dist",
  "backgroundColor": "#E8EBE9",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 700,
      "launchAutoHide": false,
      "backgroundColor": "#E8EBE9",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT",
      "backgroundColor": "#00000000"
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    },
    "PlayIntegrity": {
      "cloudProjectNumber": ""
    }
  }
}
